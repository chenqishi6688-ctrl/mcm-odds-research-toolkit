{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/mcm/identity-registry-v1.schema.json",
  "title": "MCM reviewed cross-provider team identities",
  "type": "object",
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "mcm-identity-registry/v1"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["canonical_team_id", "canonical_name", "providers"],
        "properties": {
          "canonical_team_id": {"type": "string", "minLength": 1},
          "canonical_name": {"type": "string", "minLength": 1},
          "providers": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["names"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

